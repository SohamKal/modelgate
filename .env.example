# Local-only development values. Change both passwords before sharing a running stack.
POSTGRES_DB=modelgate
POSTGRES_USER=modelgate
POSTGRES_PASSWORD=local-dev-only
MODELGATE_POSTGRES_PORT=55432
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-dev-only

# Public localhost demo key. Replace for shared use; this is not a provider credential.
MODELGATE_CLIENT_API_KEY=local-client-demo-only
MODELGATE_STABLE_RELEASE=fake
MODELGATE_VERIFICATION_PROVIDER=groq
MODELGATE_MAX_REQUEST_BYTES=65536
MODELGATE_MAX_OUTPUT_TOKENS=1024
MODELGATE_SERVING_DEADLINE_SECONDS=10
MODELGATE_SERVING_CONCURRENCY=20

# Required only for OpenAI serving/live validation. Supply two distinct accessible model IDs.
OPENAI_API_KEY=
OPENAI_MODEL_A=
OPENAI_MODEL_B=
# Enable only if the selected model supports temperature; null requests omit it upstream.
MODELGATE_OPENAI_A_SUPPORTS_TEMPERATURE=false
MODELGATE_OPENAI_B_SUPPORTS_TEMPERATURE=false

# Free-plan verification targets; create a local Groq key at https://console.groq.com/keys.
GROQ_API_KEY=
GROQ_MODEL_A=openai/gpt-oss-20b
GROQ_MODEL_B=openai/gpt-oss-120b
MODELGATE_GROQ_A_SUPPORTS_TEMPERATURE=false
MODELGATE_GROQ_B_SUPPORTS_TEMPERATURE=false

# Reserved for later milestones; raw content is not stored in M2.
MODELGATE_CONTENT_CAPTURE=false
MODELGATE_SHADOW_QUEUE_SIZE=100
MODELGATE_SHADOW_CONSUMERS=2
